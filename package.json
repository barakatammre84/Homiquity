{
  "name": "homiquity",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index-dev.ts",
    "build": "vite build && esbuild server/index-prod.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "vercel-build": "vite build && esbuild server/app.ts --platform=node --packages=external --bundle --format=esm --outfile=api/_app.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "mcp": "tsx server/mcp/index.ts",
    "checkup": "bash scripts/checkup.sh",
    "reg:watch": "node scripts/regulatory-watch.cjs",
    "reg:watch:save": "node scripts/regulatory-watch.cjs --update-state",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:adopt": "tsx server/scripts/markMigrationsApplied.ts",
    "db:migrate:prod": "node scripts/migrate-prod.cjs",
    "db:push": "drizzle-kit push",
    "data:hmda": "tsx server/scripts/ingestHmdaCompetitors.ts",
    "data:fannie": "tsx server/scripts/ingestFannieMaePerformance.ts",
    "guard:schema": "node scripts/schema-migration-guard.cjs",
    "coach:ab": "tsx scripts/coachModelAb.ts",
    "db:start": "docker start homiquity-db 2>/dev/null || docker run -d --name homiquity-db -e POSTGRES_PASSWORD=pass -e POSTGRES_DB=homiquity -p 5432:5432 postgres:16",
    "sync": "git pull --no-edit origin main && git push origin main",
    "save": "git add -A && git commit -m \"checkpoint: $(date '+%Y-%m-%d %H:%M')\" && npm run sync"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@google-cloud/storage": "^7.19.0",
    "@hookform/resolvers": "^3.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.9",
    "@types/pdfkit": "^0.17.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "framer-motion": "^11.18.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.453.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "pdfjs-dist": "6.1.200",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.1",
    "plaid": "^41.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-plaid-link": "^4.1.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^4.0.18",
    "wouter": "^3.3.5",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/node": "^22.19.17",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.12",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^7.3.2"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1",
      "esbuild@~0.18.20": "0.25.0"
    }
  }
}
