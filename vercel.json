{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "api/_app.mjs"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/jobs/lifecycle", "schedule": "0 13 * * *" },
    { "path": "/api/jobs/rate-lock-alerts", "schedule": "0 12 * * *" },
    { "path": "/api/jobs/adverse-action-delivery", "schedule": "0 14 * * *" },
    { "path": "/api/jobs/aggregate-data", "schedule": "17 11 * * 1" }
  ]
}
