# Copy this file to .env and fill in the values. .env is gitignored — never commit it.
# The dev server loads .env automatically (via dotenv in server/index-dev.ts).

# --- Database (required) -----------------------------------------------------
# Fully local (offline, free): run Postgres locally and use a localhost URL —
# the app auto-uses the standard pg driver for localhost/127.0.0.1.
#   docker run -d -e POSTGRES_PASSWORD=pass -e POSTGRES_DB=homiquity -p 5432:5432 postgres:16
#   DATABASE_URL=postgresql://postgres:pass@localhost:5432/homiquity
# Or hosted free: create a database at https://neon.tech and paste its URL.
DATABASE_URL=
# Force the local pg driver even for a non-localhost URL (rarely needed):
# USE_LOCAL_PG=true

# --- Security secrets (required — the server refuses to boot without these) ---
# Generate each with the command shown, then paste the output.
# CREDIT_ENCRYPTION_KEY : openssl rand -base64 32
CREDIT_ENCRYPTION_KEY=
# PII_HASH_SALT         : openssl rand -hex 32
PII_HASH_SALT=
# SESSION_SECRET        : openssl rand -hex 32
SESSION_SECRET=

# --- AI (optional — document extraction / AI features use Gemini) ------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Local dev conveniences --------------------------------------------------
NODE_ENV=development
# 5001 on macOS — AirPlay Receiver squats on port 5000.
PORT=5001
# Enables the /api/test-login dev accounts (non-production only). Pick any password.
DEV_TEST_PASSWORD=

# --- Scheduled jobs -----------------------------------------------------------
# Authenticates Vercel's daily cron call to /api/jobs/lifecycle (equity
# snapshots, PMI/refi alerts). Generate with: openssl rand -hex 24
# Set the SAME value in the Vercel project env vars — without it the cron
# cannot authenticate and the job only runs manually (admin).
CRON_SECRET=

# --- Object storage (documents / uploads) ------------------------------------
# Off-Replit (Vercel, local, any host), storage uses Google Cloud Storage with a
# standard service account:
#   1. Create a GCS bucket + a service account with "Storage Object Admin" on it.
#   2. Download the service-account JSON key and paste the WHOLE JSON here
#      (single line) — or set GOOGLE_APPLICATION_CREDENTIALS to the file path.
# GCS_SERVICE_ACCOUNT_KEY=
# Bucket paths (format: /<bucket-name>/<prefix>):
# PRIVATE_OBJECT_DIR=/my-bucket/private
# PUBLIC_OBJECT_SEARCH_PATHS=/my-bucket/public

# --- AI gateway provider (optional) ------------------------------------------
# Leave unset to use Gemini. Set to "claude" only after installing @anthropic-ai/sdk
# and setting ANTHROPIC_API_KEY.
# AI_GATEWAY_PROVIDER=gemini
# ANTHROPIC_API_KEY=
# Alternate AI credentials some services read (fall back to GEMINI_API_KEY):
# AI_INTEGRATIONS_GEMINI_API_KEY=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# --- Webhooks (REQUIRED in production if the Plaid assets webhook is used) ----
# Shared secret checked on POST /api/webhooks/plaid-assets. In production the
# endpoint returns 503 until this is set (fail-closed). Generate:
# openssl rand -hex 24 — and configure the same value on the webhook sender.
# PLAID_WEBHOOK_SECRET=

# --- Vendor integrations (optional — simulated until contracts are signed) ----
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# CRS_API_KEY=
# ISOFTPULL_API_KEY=
# FANNIE_DU_API_KEY=
# HOUSECANARY_API_KEY=
# RAPIDAPI_KEY=
# GOOGLE_MAPS_API_KEY=

# --- Email (optional — notifications disabled when unset) --------------------
# SENDGRID_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=
# FROM_NAME=

# --- Social login (optional) --------------------------------------------------
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# --- Misc tuning (optional, sensible defaults in code) ------------------------
# PUBLIC_BASE_URL=          # absolute URL used in emails/links
# AUS_TIMEOUT_MS=
# MCP_VENDOR_TIMEOUT_MS=
# LOOKUP_MATRIX_STAMP_WINDOW_MS=
# PRICING_MARGIN_BASE_BPS=
