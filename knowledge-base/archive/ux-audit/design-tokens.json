{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Obsidian Indigo — exported from client/src/index.css + design_guidelines.md. HSL values are the CSS-variable source of truth; hex provided for design tools.",
  "color": {
    "ramp": {
      "obsidian-950": { "value": "#050B14", "hsl": "216 60% 5%", "usage": "primary type & actions" },
      "deep-ink-900": { "value": "#0C1625", "hsl": "216 51% 10%", "usage": "nav/sidebars, accent" },
      "steel-blue-700": { "value": "#1D2D44", "hsl": "215 40% 19%", "usage": "dark-mode borders" },
      "muted-slate-500": { "value": "#3E5370", "hsl": "215 29% 34%", "usage": "secondary text" },
      "dusty-ice-300": { "value": "#889DBE", "hsl": "217 29% 64%", "usage": "tertiary/disabled" },
      "frost-tint-100": { "value": "#D0DDF0", "hsl": "216 52% 88%", "usage": "hairline borders" },
      "paper-ice-50": { "value": "#F2F6FC", "hsl": "216 63% 97%", "usage": "canvas (Layer 0)" }
    },
    "semantic": {
      "success": { "value": "#10B981", "hsl": "160 84% 39%", "usage": "approvals, Day-1 Certainty" },
      "warning": { "value": "#F59E0B", "hsl": "38 92% 51%", "usage": "pending review" },
      "danger": { "value": "#EF4444", "hsl": "0 84% 60%", "usage": "errors, adverse states" },
      "info": { "value": "hsl(216 51% 40%)", "usage": "informational (in-ramp mid value)" }
    },
    "surface": {
      "background": { "ref": "color.ramp.paper-ice-50" },
      "card": { "value": "#FFFFFF", "note": "Layer 1: white card + 1px frost hairline, no default shadow" },
      "sidebar": { "ref": "color.ramp.deep-ink-900" },
      "primary-action": { "ref": "color.ramp.obsidian-950" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Geist, Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "serif": "Source Serif 4, Georgia, serif",
      "mono": "Geist Mono, JetBrains Mono, monospace"
    },
    "scale": {
      "hero": { "mobile": "3rem", "desktop": "4.5rem", "weight": 700, "tracking": "-0.02em" },
      "section": { "mobile": "2rem", "desktop": "3rem", "weight": 600, "tracking": "-0.02em" },
      "cardTitle": { "mobile": "1.25rem", "desktop": "1.5rem", "weight": 600 },
      "financialFigure": { "size": "1.5rem–2rem", "weight": 600, "fontFeature": "tabular-nums" },
      "body": { "size": "1rem", "weight": 400, "lineHeight": 1.6 },
      "caption": { "size": "0.875rem", "weight": 400 }
    }
  },
  "spacing": {
    "base": "0.25rem",
    "allowedSteps": [2, 4, 6, 8, 12, 16],
    "componentPadding": "p-6 to p-8",
    "sectionSpacing": { "mobile": "py-12", "desktop": "py-16" },
    "formFieldGap": "space-y-4"
  },
  "radius": {
    "default": "0.75rem",
    "note": "Precision radius: 12px cards, tighter than consumer-soft"
  },
  "elevation": {
    "philosophy": "Near-flat, hue-tinted shadows; 1px Frost hairlines carry depth. Interactive depth via --elevate-1 (3%) / --elevate-2 (6%) overlay utilities, not shadows.",
    "shadow-xs": "0 1px 3px 0 hsl(216 60% 10% / 0.04), 0 1px 2px -1px hsl(216 60% 10% / 0.03)",
    "shadow-sm": "0 2px 6px -1px hsl(216 60% 10% / 0.05), 0 1px 2px -1px hsl(216 60% 10% / 0.03)",
    "shadow-md": "0 6px 16px -4px hsl(216 60% 10% / 0.07)",
    "shadow-lg": "0 10px 24px -6px hsl(216 60% 10% / 0.08), 0 3px 8px -3px hsl(216 60% 10% / 0.05)",
    "shadow-xl": "0 16px 32px -8px hsl(216 60% 10% / 0.10), 0 6px 12px -4px hsl(216 60% 10% / 0.06)"
  },
  "zIndex": {
    "elevateOverlay": 999,
    "note": "Radix primitives (dialog/popover/toast) manage their own stacking; elevate ::after overlays use z-index 999 within their stacking context (client/src/index.css)."
  },
  "motion": {
    "loading": "field-level animate-skeleton-precision pulse (Frost→Paper); never generic spinners",
    "funnelStep": "directional slide keyed on FunnelState.direction (1 advance / -1 back)"
  },
  "accessibility": {
    "touchTarget": "44px minimum on mobile (.touch-target, client/src/index.css)",
    "safeArea": ".safe-area-bottom for iOS home indicator",
    "contrastNotes": "Dusty Ice #889DBE on white ≈ 2.6:1 — decorative/disabled only, never body text. Muted Slate #3E5370 on white ≈ 7.4:1 — safe for secondary text."
  }
}
