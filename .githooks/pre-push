#!/usr/bin/env bash
#
# Pre-push gate — run CI's `gate` job locally so a red never costs a CI minute.
#
# WHY THIS EXISTS. The repo is private, so Actions minutes are metered (roadmap
# KTLO-2). Measured 2026-08-17: 66 CI runs over 4.85 days = ~13.6/day, one
# billable `gate` job each at ~4-5 min = ~1,850 min/month against a 2,000-minute
# free allowance. A red gate costs that run AND the re-run after the fix, so
# catching one here saves roughly ten minutes, not five.
#
# WHAT IT RUNS. Exactly the checks CI's `gate` job runs, in the order that fails
# fastest first — nothing more. It deliberately does NOT run `pnpm build`, the
# audit, or the prod health probe; those live in `pnpm checkup`, which is the
# heavier pre-PR sweep. This hook is meant to be cheap enough that you leave it on.
#
# INSTALL:  git config core.hooksPath .githooks
# SKIP ONCE: git push --no-verify
#
# The hooks live in a TRACKED directory rather than .git/hooks so they survive a
# reclone and every worktree gets them — .git/hooks is per-clone and invisible to
# review.

set -uo pipefail

# Git pipes one line per ref on stdin. A branch DELETION (`git push origin
# :branch`) has an all-zero local sha and nothing to test, so if every ref on
# this push is a deletion we exit without running anything. Any real ref runs
# the gate. An empty stdin (hook invoked by hand) also runs it.
zero=0000000000000000000000000000000000000000
have_real_ref=0
saw_any_ref=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  saw_any_ref=1
  [ "$local_sha" != "$zero" ] && have_real_ref=1
done
if [ "$saw_any_ref" = 1 ] && [ "$have_real_ref" = 0 ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

# TOOLING PRE-FLIGHT — and it must WARN, never block.
#
# Found by this hook blocking its own author's push, one commit after it merged.
# Every routine in knowledge-base/routines/CHARTER.md works in a `git worktree`,
# and a fresh worktree has NO node_modules of its own — so `pnpm test` died with
# "vitest: command not found" and the hook reported it as a failed gate. That is
# wrong twice over: it is a statement about the checkout, not about the code, and
# a hook that blocks a push for a reason the author cannot act on teaches exactly
# one habit — `--no-verify` — which disables the control permanently.
#
# So an uninstalled checkout gets a loud, specific warning and the push proceeds;
# CI still gates the PR. Only real check failures block.
if [ ! -d node_modules ] || ! [ -x node_modules/.bin/vitest ]; then
  echo "pre-push gate SKIPPED — dependencies are not installed in this checkout"
  echo "  $(pwd)"
  echo "  install with: pnpm install --frozen-lockfile"
  echo "  (a fresh git worktree has no node_modules of its own — expected, not an error)"
  echo "  CI's gate still runs on the PR; this only skips the local pre-check."
  exit 0
fi

failed=()

step() {
  local label="$1"; shift
  printf '  %-34s' "$label"
  local start; start=$(date +%s)
  if "$@" >/tmp/prepush-gate.log 2>&1; then
    printf 'ok   (%ss)\n' "$(( $(date +%s) - start ))"
  else
    printf 'FAIL (%ss)\n' "$(( $(date +%s) - start ))"
    failed+=("$label")
    tail -30 /tmp/prepush-gate.log | sed 's/^/      | /'
  fi
}

echo "pre-push gate — mirroring CI's \`gate\` job"

# Order is fail-fastest-first: 25s of tsc beats 3 minutes of vitest when the
# break is a type error, which is the common case.
step "typecheck (tsc)"          npx tsc --noEmit
step "schema <-> migrations"    node scripts/schema-migration-guard.cjs
step "design tokens"            node scripts/design-token-guard.cjs
step "unit tests (node+client)" pnpm test

if [ ${#failed[@]} -gt 0 ]; then
  echo
  echo "push BLOCKED — ${#failed[@]} check(s) failed: ${failed[*]}"
  echo "full output: /tmp/prepush-gate.log"
  echo "override once with: git push --no-verify"
  exit 1
fi

echo "all green — pushing"
exit 0
