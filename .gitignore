node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz
uploads

# MISMO XML exports (generated at runtime, not source)
mismo-*.xml
.vite-cache/

# Per-session git worktrees (TEAM_PRACTICES §4: one session = one worktree =
# one branch). They live inside the repo but are never part of it.
.claude/worktrees/

# Secrets. `.env*` is deliberately broad — it catches `.env.production`,
# `.env.railway` and any other suffix someone invents, which the old explicit
# `.env` + `.env.local` pair did not. ORDER MATTERS: the negation must stay
# BELOW the wildcard, because git applies the LAST matching rule. Appending
# `.env*` underneath `!.env.example` (as an earlier edit did) silently
# re-ignores the tracked template this negation exists to keep.
.env*
!.env.example

# Vercel's local project link. #424 removed the Vercel platform surface and the
# project itself is deleted, so nothing here should ever produce this folder —
# but the CLI recreates it on any stray `vercel` invocation, and it carries
# project/org IDs that Vercel's own README says not to commit. Kept as a guard
# against re-adding a dead platform's identifiers, NOT as a sign Vercel is a
# deploy target. It is not; Railway is.
.vercel

# Transpiled scratch copies of the vitest configs, written by
# scripts/test-collection-guard.cjs so it can read each lane's real `include`
# list instead of restating it. Written to the repo root because that is where
# `vitest/config` resolves from and where `__dirname` has to point; removed in a
# `finally`, so one appearing here means a run was killed mid-flight.
.hq-test-collection-guard.*.mjs
# The ralph-loop state file. Written by the plugin's setup script (outside the repo)
# and rewritten on every iteration, so it is per-run scratch and never shared state.
# The acceptance run in handoff ch.12 had to remember to leave it untracked by hand.
.claude/ralph-loop.local.md
